# ---------------------------------------------------------------------------
# abscribe_backend environment template
# Copy to .env  (cp .env.example .env)  and fill in real values.
# NEVER commit the real .env — it is gitignored.
# ---------------------------------------------------------------------------

# === REQUIRED ===============================================================
# OpenAI key used for prompt/hint generation AND difficulty calibration.
OPENAI_API_KEY=sk-REPLACE_ME
# Model used for *generation* (chat / question authoring).
OPENAI_MODEL=gpt-3.5-turbo

# === GOOGLE SHEETS AUTH (pick ONE) =========================================
# Preferred for production: a service-account JSON file. Default lookup path is
#   abscribe_backend/abscribe_backend/services/service_account_file.json
# Set this to override the location (absolute path recommended on a server):
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service_account_file.json
#
# Alternative for PUBLIC ("anyone with the link") sheets only — no OAuth needed:
# GOOGLE_API_KEY=AIza-REPLACE_ME
#
# OAuth fallback (interactive; usually only for local dev):
# GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/to/credentials.json
# GOOGLE_TOKEN_FILE=/absolute/path/to/token.json
# GOOGLE_ALLOW_INTERACTIVE_AUTH=0

# === DIFFICULTY CALIBRATION (optional; sensible defaults) ===================
# Number of simulated LLM respondents per problem. 150 = paper default; lower for demos.
QUESTION_DIFFICULTY_N_RESPONDENTS=150
# Force anchor (FIPC) calibration on. Leave blank or 0 for free Rasch (default).
# QUESTION_DIFFICULTY_USE_ANCHOR_CALIBRATION=1
# Model for the calibration respondents (default in code: gpt-4o). Independent of OPENAI_MODEL.
QUESTION_DIFFICULTY_CALIBRATION_MODEL=gpt-4o
# Max concurrent respondent OpenAI calls during calibration (default in code: 40).
# QUESTION_DIFFICULTY_ASYNC_CONCURRENCY=40
# 429 retry budget for respondent calls (default 6).
# QUESTION_DIFFICULTY_RATE_LIMIT_RETRIES=6
# QUESTION_DIFFICULTY_CALIBRATION_TEMPERATURE=1.0
# QUESTION_DIFFICULTY_SEED=42
# QUESTION_DIFFICULTY_MIN_INFORMATIVE_NEW=1
# Difficulty->logit clamp used when mapping the Easy..Hard slider.
# DIFFICULTY_MIN_LOGIT=-3.0
# DIFFICULTY_MAX_LOGIT=3.0
# Anchor bundle CSVs ship with the repo; override only if relocating them:
# QUESTION_DIFFICULTY_ANCHOR_ITEMS_CSV=
# QUESTION_DIFFICULTY_ANCHOR_RESPONSES_CSV=
# QUESTION_DIFFICULTY_ANCHOR_PARAMS_CSV=
# QUESTION_DIFFICULTY_ANCHOR_MANIFEST=

# === FIRESTORE EVENT LOGGING (optional; off by default) ====================
# Absolute path to the Firebase service-account JSON on the server. Writes
# go to collections under PromptHive/{PROMPTHIVE_FIRESTORE_ENV}/ in the lab
# Firebase project. Leave unset to disable logging entirely — the app logs
# a single warning at startup and runs normally.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase_service_account.json
# Environment segment under the PromptHive root collection ("dev" or "prod").
# PROMPTHIVE_FIRESTORE_ENV=dev
# Optional override for the appVersion field stamped on every event. By
# default the module uses `git rev-parse --short HEAD` at startup.
# PROMPTHIVE_APP_VERSION=

# === PUBLIC PAGES ACCESS CODE (optional) ===================================
# When set, /chatGPT/* and /api/* require header X-PromptHive-Access-Code.
# Leave empty for local development (check disabled; one warning at startup).
PROMPTHIVE_ACCESS_CODE=

# === FLASK (optional; defaults exist but set real values in production) =====
# SECRET_KEY=generate-with-secrets.token_urlsafe
# SECURITY_PASSWORD_SALT=generate-a-random-salt

# === OPTIONAL / CURRENTLY UNUSED ===========================================
# MongoDB is disabled in this build (prompt-library degrades gracefully), so no
# Mongo URI is required for the difficulty-filter feature.
# RESEND_API_KEY is only used by email_service.py, which nothing imports at
# startup — leave unset unless you wire up email features.
# RESEND_API_KEY=
