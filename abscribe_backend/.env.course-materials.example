# Copy to .env.course-materials; both API and worker load this exact file.
# Pipeline code is bundled. Optional separate writable working directory:
# COURSE_MATERIALS_PIPELINE_DATA_DIR=/absolute/path/to/durable/private/course-materials/pipeline
COURSE_MATERIALS_DATA_DIR=/absolute/path/to/durable/private/course-materials
COURSE_MATERIALS_LOCAL_DEV=1
COURSE_MATERIALS_UPLOAD_MODE=local
COURSE_MATERIALS_PROCESSING_ENABLED=0
COURSE_MATERIALS_PUBLISH_ENABLED=0
# For production: LOCAL_DEV=0; HTTPS; provision instructor accounts.
# COURSE_MATERIALS_SECRET_KEY=<generate 32+ random characters>
# COURSE_MATERIALS_ALLOWED_ORIGINS=https://instructors.example.edu
# AWS_PROFILE=oatutor-docs
# COURSE_MATERIALS_UPLOAD_MODE=s3
# COURSE_MATERIALS_UPLOAD_BUCKET=oatutor-course-docs-bucket
# COURSE_MATERIALS_UPLOAD_REGION=us-west-2
# COURSE_DOCS_S3_BUCKET=oatutor-course-docs-bucket
# COURSE_MATERIALS_COMPILE_REGION=us-west-2
# BDA_PROJECT_ARN=<verified project ARN>
# BDA_PROFILE_ARN=<verified profile ARN>
# SEMANTIC_COMPILER_PROVIDER=openai
# OPENAI_API_KEY=<server-side key; never commit>
# COURSE_DOCS_RUNTIME_BUCKET=oatutor-runtime-course-docs
# COURSE_DOCS_RUNTIME_REGION=us-west-1
# COURSE_DOCS_RUNTIME_PREFIX=documents
